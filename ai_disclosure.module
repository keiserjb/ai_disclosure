/**
 * Returns available AI disclosure levels.
 *
 * @return array
 *   Array of taxonomy definitions keyed by level machine name.
 */
function ai_disclosure_get_levels() {
  $levels = [
    'human_only' => [
      'title' => t('Human Only'),
      'label' => t('Human-Authored'),
      'badge_class' => 'ai-disclosure-badge--human',
      'description' => t('Authored entirely by humans without generative AI text or image tools.'),
      'icon' => '',
      'meta_source' => '',
    ],
    'ai_assisted' => [
      'title' => t('AI-Assisted'),
      'label' => t('AI-Assisted Content'),
      'badge_class' => 'ai-disclosure-badge--assisted',
      'description' => t('Authored by humans with AI brainstorming, structuring, drafting, or editing assistance.'),
      'icon' => 'ai-modified.svg',
      'meta_source' => 'http://cv.iptc.org/newscodes/digitalsourcetype/compositeWithTrainedAlgorithmicMedia',
    ],
    'ai_generated' => [
      'title' => t('AI-Generated'),
      'label' => t('AI-Generated Content'),
      'badge_class' => 'ai-disclosure-badge--generated',
      'description' => t('Substantially generated by AI models with human editorial review and sign-off.'),
      'icon' => 'ai-generated.svg',
      'meta_source' => 'http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia',
    ],
    'synthetic_media' => [
      'title' => t('Synthetic Media / Deepfake'),
      'label' => t('Synthetic Media'),
      'badge_class' => 'ai-disclosure-badge--synthetic',
      'description' => t('Synthetically created or manipulated realistic audio, imagery, or video.'),
      'icon' => 'ai-generated.svg',
      'meta_source' => 'http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia',
    ],
  ];

  backdrop_alter('ai_disclosure_levels', $levels);
  return $levels;
}

/**
 * Returns enabled node bundles. An explicit empty list stays empty.
 */
function ai_disclosure_enabled_bundles() {
  $bundles = config('ai_disclosure.settings')->get('enabled_bundles');
  if ($bundles === NULL) {
    return ['article', 'page', 'post'];
  }
  return array_values(array_filter((array) $bundles));
}

/**
 * Builds an unsaved default disclosure record. Does not query or replace tokens.
 */
function ai_disclosure_default_record($entity_type, $entity_id, $revision_id = 0) {
  $config = config('ai_disclosure.settings');
  $responsibility = $config->get('default_editorial_responsibility');
  if ($responsibility === NULL || $responsibility === '') {
    $responsibility = '[site:name]';
  }
  return [
    'entity_type' => $entity_type,
    'entity_id' => (int) $entity_id,
    'revision_id' => $revision_id ? (int) $revision_id : 0,
    'disclosure_level' => $config->get('default_level') ?: 'human_only',
    'human_review' => 0,
    'editorial_responsibility' => $responsibility,
    'notes' => '',
    'tool_used' => '',
    'created' => 0,
    'changed' => 0,
    'is_default' => TRUE,
  ];
}

/**
 * Resolves editorial responsibility, including an unreplaced token default.
 */
function ai_disclosure_responsibility(array $record) {
  $value = isset($record['editorial_responsibility']) ? $record['editorial_responsibility'] : '';
  if ($value === '') {
    $value = config('ai_disclosure.settings')->get('default_editorial_responsibility') ?: '[site:name]';
  }
  if (strpos($value, '[') !== FALSE && module_exists('token')) {
    $value = token_replace($value);
  }
  return $value;
}

/**
 * Loads a disclosure record for an entity.
 *
 * @param string $entity_type
 *   Entity type machine name, e.g. 'node'.
 * @param int $entity_id
 *   Entity ID.
 * @param int|null $revision_id
 *   Specific revision ID, or NULL for latest revision.
 *
 * @return array
 *   Associative array representing disclosure status.
 */
function ai_disclosure_get($entity_type, $entity_id, $revision_id = NULL) {
  $query = db_select('ai_disclosure', 'd')
    ->fields('d')
    ->condition('entity_type', $entity_type)
    ->condition('entity_id', (int) $entity_id);

  if ($revision_id !== NULL && $revision_id > 0) {
    $query->condition('revision_id', (int) $revision_id);
  }
  else {
    $query->orderBy('revision_id', 'DESC');
  }

  $record = $query->execute()->fetchAssoc();

  if ($record) {
    $record['is_default'] = FALSE;
    return $record;
  }

  return ai_disclosure_default_record($entity_type, $entity_id, $revision_id);
}

/**
 * Persists an AI disclosure record and appends an audit history entry.
 *
 * @param string $entity_type
 *   Entity type machine name, e.g. 'node'.
 * @param int $entity_id
 *   Entity ID.
 * @param int $revision_id
 *   Revision ID (defaults to 0 if not revisioned).
 * @param array $data
 *   Disclosure attributes:
 *   - disclosure_level (string)
 *   - human_review (int|bool)
 *   - editorial_responsibility (string)
 *   - notes (string)
 *   - tool_used (string)
 *
 * @return bool
 *   TRUE on success.
 */
function ai_disclosure_save($entity_type, $entity_id, $revision_id = 0, array $data = []) {
  global $user;

  $config = config('ai_disclosure.settings');
  $revision_id = (int) $revision_id;
  $entity_id = (int) $entity_id;

  $levels = ai_disclosure_get_levels();
  $level = !empty($data['disclosure_level']) ? $data['disclosure_level'] : ($config->get('default_level') ?: 'human_only');
  if (!isset($levels[$level])) {
    watchdog('ai_disclosure', 'Rejected unknown disclosure level @level for @type @id.', [
      '@level' => $level,
      '@type' => $entity_type,
      '@id' => $entity_id,
    ], WATCHDOG_WARNING);
    return FALSE;
  }
  $human_review = !empty($data['human_review']) ? 1 : 0;
  $editorial_resp = isset($data['editorial_responsibility']) ? trim($data['editorial_responsibility']) : '';
  if ($editorial_resp === '') {
    $editorial_resp = $config->get('default_editorial_responsibility') ?: '[site:name]';
  }
  $notes = isset($data['notes']) ? trim($data['notes']) : '';
  $tool_used = isset($data['tool_used']) ? trim($data['tool_used']) : '';

  $now = REQUEST_TIME;

  $fields = [
    'entity_type' => $entity_type,
    'entity_id' => $entity_id,
    'revision_id' => $revision_id,
    'disclosure_level' => $level,
    'human_review' => $human_review,
    'editorial_responsibility' => $editorial_resp,
    'notes' => $notes,
    'tool_used' => $tool_used,
    'changed' => $now,
  ];

  $existing = db_select('ai_disclosure', 'd')
    ->fields('d')
    ->condition('entity_type', $entity_type)
    ->condition('entity_id', $entity_id)
    ->condition('revision_id', $revision_id)
    ->execute()
    ->fetchAssoc();

  $transaction = db_transaction();
  try {
    if ($existing) {
      $unchanged = TRUE;
      foreach (['disclosure_level', 'human_review', 'editorial_responsibility', 'notes', 'tool_used'] as $key) {
        if ((string) $existing[$key] !== (string) $fields[$key]) {
          $unchanged = FALSE;
          break;
        }
      }
      if ($unchanged) {
        return TRUE;
      }
      db_update('ai_disclosure')
        ->fields($fields)
        ->condition('entity_type', $entity_type)
        ->condition('entity_id', $entity_id)
        ->condition('revision_id', $revision_id)
        ->execute();
    }
    else {
      $fields['created'] = $now;
      db_insert('ai_disclosure')
        ->fields($fields)
        ->execute();
    }

    // Record append-only audit trail only when values change.
    db_insert('ai_disclosure_history')
      ->fields([
        'entity_type' => $entity_type,
        'entity_id' => $entity_id,
        'revision_id' => $revision_id,
        'disclosure_level' => $level,
        'human_review' => $human_review,
        'editorial_responsibility' => $editorial_resp,
        'notes' => $notes,
        'uid' => isset($user->uid) ? (int) $user->uid : 0,
        'timestamp' => $now,
      ])
      ->execute();
  }
  catch (Throwable $e) {
    $transaction->rollback();
    throw $e;
  }
  unset($transaction);

  module_invoke_all('ai_disclosure_save', $entity_type, $entity_id, $revision_id, $fields);

  return TRUE;
}

/**
 * Deletes disclosure records for an entity or specific revision.
 *
 * @param string $entity_type
 *   Entity type.
 * @param int $entity_id
 *   Entity ID.
 * @param int|null $revision_id
 *   Specific revision to delete, or NULL to delete all revisions for the entity.
 */
function ai_disclosure_delete($entity_type, $entity_id, $revision_id = NULL) {
  $query = db_delete('ai_disclosure')
    ->condition('entity_type', $entity_type)
    ->condition('entity_id', (int) $entity_id);

  if ($revision_id !== NULL && $revision_id > 0) {
    $query->condition('revision_id', (int) $revision_id);
  }
  else {
    // Also remove audit history if deleting entire entity.
    db_delete('ai_disclosure_history')
      ->condition('entity_type', $entity_type)
      ->condition('entity_id', (int) $entity_id)
      ->execute();
  }

  $query->execute();
}

/**
 * Records AI tool usage for an entity and automatically suggests or tags disclosure.
 *
 * @param string $entity_type
 *   Entity type (e.g. 'node').
 * @param int $entity_id
 *   Entity ID.
 * @param string $tool_name
 *   Name of AI tool (e.g. 'ai_content', 'ai_alt', 'ai_agent').
 * @param string $suggested_level
 *   Suggested disclosure level (default 'ai_assisted').
 * @param int $revision_id
 *   Optional revision ID.
 *
 * @return array|false
 *   Updated disclosure record, or FALSE if the record was rejected.
 */
function ai_disclosure_record_tool_usage($entity_type, $entity_id, $tool_name, $suggested_level = 'ai_assisted', $revision_id = 0) {
  $revision_id = (int) $revision_id;
  if ($revision_id <= 0 && $entity_type === 'node' && $entity_id) {
    $revision_id = (int) db_query('SELECT vid FROM {node} WHERE nid = :nid', [':nid' => (int) $entity_id])->fetchField();
  }
  if ($revision_id <= 0) {
    watchdog('ai_disclosure', 'Refused tool usage record for @type @id without a revision id.', [
      '@type' => $entity_type,
      '@id' => $entity_id,
    ], WATCHDOG_WARNING);
    return FALSE;
  }

  $current = ai_disclosure_get($entity_type, $entity_id, $revision_id);
  $data = $current ?: [];

  $tools = [];
  if (!empty($data['tool_used'])) {
    $tools = array_map('trim', explode(',', $data['tool_used']));
  }
  if (!in_array($tool_name, $tools)) {
    $tools[] = $tool_name;
  }
  $data['tool_used'] = implode(', ', $tools);

  if (empty($data['disclosure_level']) || $data['disclosure_level'] === 'human_only') {
    $data['disclosure_level'] = $suggested_level;
  }

  if (!ai_disclosure_save($entity_type, $entity_id, $revision_id, $data)) {
    return FALSE;
  }
  return ai_disclosure_get($entity_type, $entity_id, $revision_id);
}

/**
 * Implements hook_form_node_form_alter().
 */
function ai_disclosure_form_node_form_alter(array &$form, array &$form_state) {
  $node = $form['#node'];
  $config = config('ai_disclosure.settings');
  $enabled_bundles = ai_disclosure_enabled_bundles();

  if (!in_array($node->type, $enabled_bundles)) {
    return;
  }

  if (!user_access('edit ai disclosure') && !user_access('administer ai disclosure')) {
    return;
  }

  $existing = !empty($node->nid) ? ai_disclosure_get('node', $node->nid, isset($node->vid) ? $node->vid : NULL) : NULL;
  $default_level = $existing ? $existing['disclosure_level'] : ($config->get('default_level') ?: 'human_only');
  $default_human_review = $existing ? $existing['human_review'] : 0;
  $default_resp = $existing ? $existing['editorial_responsibility'] : token_replace($config->get('default_editorial_responsibility') ?: '[site:name]');
  $default_notes = $existing ? $existing['notes'] : '';
  $tool_used = $existing ? $existing['tool_used'] : '';

  $form['ai_disclosure'] = [
    '#type' => 'fieldset',
    '#title' => t('AI Disclosure'),
    '#collapsible' => TRUE,
    '#collapsed' => TRUE,
    '#group' => 'additional_settings',
    '#weight' => 35,
    '#tree' => TRUE,
    '#attached' => [
      'js' => [backdrop_get_path('module', 'ai_disclosure') . '/js/ai_disclosure_admin.js'],
    ],
  ];

  $levels = ai_disclosure_get_levels();
  $options = [];
  foreach ($levels as $key => $info) {
    $options[$key] = $info['title'] . ' — ' . $info['description'];
  }

  $form['ai_disclosure']['disclosure_level'] = [
    '#type' => 'radios',
    '#title' => t('Disclosure level'),
    '#options' => $options,
    '#default_value' => $default_level,
    '#required' => TRUE,
  ];

  $form['ai_disclosure']['human_review'] = [
    '#type' => 'checkbox',
    '#title' => t('Human editorial review completed'),
    '#description' => t('Check if a human editor reviewed and verified the content before publication.'),
    '#default_value' => (bool) $default_human_review,
  ];

  $form['ai_disclosure']['editorial_responsibility'] = [
    '#type' => 'textfield',
    '#title' => t('Editorial responsibility holder'),
    '#description' => t('Organization, author, or desk taking editorial accountability under EU AI Act Article 50(4).'),
    '#default_value' => $default_resp,
    '#maxlength' => 255,
  ];

  $form['ai_disclosure']['notes'] = [
    '#type' => 'textarea',
    '#title' => t('Transparency notes & models used'),
    '#description' => t('Public notes about tools or models used to produce this revision. Leave out private information.'),
    '#default_value' => $default_notes,
    '#rows' => 3,
  ];

  $form['ai_disclosure']['tool_used'] = [
    '#type' => 'value',
    '#value' => $tool_used,
  ];

  // Submit handler ensures values transfer to entity before save.
  $form['#submit'][] = 'ai_disclosure_node_form_submit';
}

/**
 * Submit handler for node forms.
 */
function ai_disclosure_node_form_submit(array $form, array &$form_state) {
  if (isset($form_state['values']['ai_disclosure'])) {
    $form_state['node']->ai_disclosure = $form_state['values']['ai_disclosure'];
    $form_state['node']->ai_disclosure_from_form = TRUE;
  }
}

/**
 * Implements hook_node_submit().
 */
function ai_disclosure_node_submit($node, $form, &$form_state) {
  if (isset($form_state['values']['ai_disclosure'])) {
    $node->ai_disclosure = $form_state['values']['ai_disclosure'];
    $node->ai_disclosure_from_form = TRUE;
  }
}

/**
 * Implements hook_node_load().
 */
function ai_disclosure_node_load($nodes, $types) {
  $config = config('ai_disclosure.settings');
  $enabled_bundles = ai_disclosure_enabled_bundles();

  $vids = [];
  foreach ($nodes as $nid => $node) {
    if (in_array($node->type, $enabled_bundles)) {
      $vid = !empty($node->vid) ? (int) $node->vid : 0;
      $vids[$vid] = $nid;
    }
  }

  if (empty($vids)) {
    return;
  }

  $result = db_select('ai_disclosure', 'd')
    ->fields('d')
    ->condition('entity_type', 'node')
    ->condition('revision_id', array_keys($vids), 'IN')
    ->execute();

  $found = [];
  foreach ($result as $row) {
    $record = (array) $row;
    $record['is_default'] = FALSE;
    if (isset($vids[$record['revision_id']])) {
      $nid = $vids[$record['revision_id']];
      $nodes[$nid]->ai_disclosure = $record;
      $found[$nid] = TRUE;
    }
  }

  foreach ($nodes as $nid => $node) {
    if (in_array($node->type, $enabled_bundles) && empty($found[$nid])) {
      $nodes[$nid]->ai_disclosure = ai_disclosure_default_record('node', $node->nid, !empty($node->vid) ? $node->vid : 0);
    }
  }
}

/**
 * Implements hook_node_insert().
 */
function ai_disclosure_node_insert($node) {
  if (empty($node->ai_disclosure_from_form)) {
    return;
  }
  $enabled = ai_disclosure_enabled_bundles();
  if (in_array($node->type, $enabled) && !empty($node->ai_disclosure)) {
    $data = (array) $node->ai_disclosure;
    ai_disclosure_save('node', $node->nid, !empty($node->vid) ? $node->vid : 0, $data);
  }
}

/**
 * Implements hook_node_update().
 */
function ai_disclosure_node_update($node) {
  if (empty($node->ai_disclosure_from_form)) {
    return;
  }
  $enabled = ai_disclosure_enabled_bundles();
  if (in_array($node->type, $enabled) && !empty($node->ai_disclosure)) {
    $data = (array) $node->ai_disclosure;
    ai_disclosure_save('node', $node->nid, !empty($node->vid) ? $node->vid : 0, $data);
  }
}

/**
 * Implements hook_node_predelete().
 */
function ai_disclosure_node_predelete($node) {
  ai_disclosure_delete('node', $node->nid);
}

/**
 * Implements hook_node_delete().
 */
function ai_disclosure_node_delete($node) {
  ai_disclosure_delete('node', $node->nid);
}

/**
 * Implements hook_entity_delete().
 */
function ai_disclosure_entity_delete($entity, $type) {
  if ($type === 'node' && isset($entity->nid)) {
    ai_disclosure_delete('node', $entity->nid);
  }
}

/**
 * Implements hook_node_revision_delete().
 */
function ai_disclosure_node_revision_delete($node) {
  ai_disclosure_delete('node', $node->nid, $node->vid);
}

/**
 * Implements hook_node_recycle_bin_purge().
 */
function ai_disclosure_node_recycle_bin_purge($node) {
  if (!empty($node->nid)) {
    ai_disclosure_delete('node', $node->nid);
  }
}

/**
 * Implements hook_entity_recycle_bin_purge().
 */
function ai_disclosure_entity_recycle_bin_purge($entity, $entity_type) {
  if ($entity_type === 'node' && !empty($entity->nid)) {
    ai_disclosure_delete('node', $entity->nid);
  }
}

/**
 * Implements hook_theme().
 */
function ai_disclosure_theme() {
  return [
    'ai_disclosure_card' => [
      'variables' => [
        'level' => 'human_only',
        'record' => [],
        'config' => NULL,
      ],
    ],
    'ai_disclosure_badge' => [
      'variables' => [
        'level' => 'human_only',
        'record' => [],
        'config' => NULL,
      ],
    ],
    'ai_disclosure_icon' => [
      'variables' => [
        'level' => 'human_only',
        'icon_name' => 'ai.svg',
      ],
    ],
  ];
}

/**
 * Themes an AI disclosure SVG icon.
 */
function theme_ai_disclosure_icon(array $variables) {
  $icon_name = basename($variables['icon_name']);
  if (!preg_match('/^[A-Za-z0-9._-]+\.svg$/', $icon_name)) {
    return '';
  }
  $module_path = backdrop_get_path('module', 'ai_disclosure');
  $file_path = BACKDROP_ROOT . '/' . $module_path . '/icons/' . $icon_name;

  if (file_exists($file_path)) {
    return file_get_contents($file_path);
  }

  return '';
}

/**
 * Themes an AI disclosure compact badge.
 */
function theme_ai_disclosure_badge(array $variables) {
  $level = $variables['level'];
  $record = $variables['record'];
  $config = $variables['config'] ?: config('ai_disclosure.settings');
  $levels = ai_disclosure_get_levels();

  $level_info = isset($levels[$level]) ? $levels[$level] : $levels['human_only'];
  $badge_class = isset($level_info['badge_class']) ? $level_info['badge_class'] : 'ai-disclosure-badge--human';

  $output = '<span class="ai-disclosure-badge ' . check_plain($badge_class) . '" title="' . check_plain($level_info['description']) . '">';
  if ($config->get('show_eu_icons') !== FALSE) {
    $output .= theme('ai_disclosure_icon', ['level' => $level, 'icon_name' => $level_info['icon']]);
  }
  $output .= '<span class="ai-disclosure-badge__label">' . check_plain($level_info['label']) . '</span>';
  $output .= '</span>';

  return $output;
}

/**
 * Themes an AI disclosure notice card.
 */
function theme_ai_disclosure_card(array $variables) {
  $level = $variables['level'];
  $record = $variables['record'];
  $config = $variables['config'] ?: config('ai_disclosure.settings');
  $levels = ai_disclosure_get_levels();

  $level_info = isset($levels[$level]) ? $levels[$level] : $levels['human_only'];

  $modifier_map = [
    'human_only' => 'ai-disclosure-card--human',
    'ai_assisted' => 'ai-disclosure-card--assisted',
    'ai_generated' => 'ai-disclosure-card--generated',
    'synthetic_media' => 'ai-disclosure-card--synthetic',
  ];
  $modifier = isset($modifier_map[$level]) ? $modifier_map[$level] : 'ai-disclosure-card--human';

  $resp = ai_disclosure_responsibility($record);
  $notes = !empty($record['notes']) ? $record['notes'] : '';
  $custom_disclaimer = trim($config->get('custom_disclaimer_text') ?: '');

  $output = '<div class="ai-disclosure-card ' . check_plain($modifier) . '" role="region" aria-label="' . check_plain(t('AI Content Disclosure')) . '">';

  $output .= '<div class="ai-disclosure-card__header">';
  if ($config->get('show_eu_icons') !== FALSE) {
    $output .= '<div class="ai-disclosure-card__icon">' . theme('ai_disclosure_icon', ['level' => $level, 'icon_name' => $level_info['icon']]) . '</div>';
  }
  $output .= '<h4 class="ai-disclosure-card__title">' . check_plain($level_info['label']) . '</h4>';
  $output .= '</div>';

  $output .= '<p class="ai-disclosure-card__body">' . check_plain($level_info['description']) . '</p>';

  $output .= '<div class="ai-disclosure-card__meta">';
  if (!empty($resp)) {
    $output .= '<span class="ai-disclosure-card__meta-item"><strong>' . t('Editorial oversight:') . '</strong> ' . check_plain($resp) . '</span>';
  }
  if (!empty($record['human_review'])) {
    $output .= '<span class="ai-disclosure-card__meta-item">✓ ' . t('Human reviewed') . '</span>';
  }
  $output .= '</div>';

  if (!empty($notes)) {
    $output .= '<div class="ai-disclosure-card__notes"><strong>' . t('Transparency notes:') . '</strong> ' . check_plain($notes) . '</div>';
  }

  if (!empty($custom_disclaimer)) {
    $output .= '<div class="ai-disclosure-card__disclaimer">' . check_plain($custom_disclaimer) . '</div>';
  }

  $output .= '</div>';

  return $output;
}

/**
 * Builds the render array for entity disclosure display.
 *
 * @param Node $node
 *   The node object.
 * @param string|null $mode
 *   Display mode ('card', 'badge', 'icon') or NULL to use config.
 *
 * @return array
 *   Render array with attached CSS.
 */
function ai_disclosure_render_disclosure($node, $mode = NULL) {
  $config = config('ai_disclosure.settings');
  $record = isset($node->ai_disclosure) ? (array) $node->ai_disclosure : ai_disclosure_get('node', $node->nid, !empty($node->vid) ? $node->vid : NULL);
  $level = !empty($record['disclosure_level']) ? $record['disclosure_level'] : ($config->get('default_level') ?: 'human_only');

  if ($level === 'human_only' && !$config->get('show_human_only_badge')) {
    return [];
  }

  if ($mode === NULL) {
    $mode = $config->get('display_mode') ?: 'card';
  }

  // Automatic injection uses none. A caller that passes an explicit mode still renders.
  if ($mode === 'none') {
    return [];
  }

  $html = '';
  switch ($mode) {
    case 'badge':
      $html = theme('ai_disclosure_badge', ['level' => $level, 'record' => $record, 'config' => $config]);
      break;

    case 'icon':
      $levels = ai_disclosure_get_levels();
      $level_info = isset($levels[$level]) ? $levels[$level] : $levels['human_only'];
      $html = '<span class="ai-disclosure-icon-only" title="' . check_plain($level_info['label'] . ' — ' . $level_info['description']) . '">';
      $html .= theme('ai_disclosure_icon', ['level' => $level, 'icon_name' => $level_info['icon']]);
      $html .= '<span class="element-invisible">' . check_plain($level_info['label']) . '</span>';
      $html .= '</span>';
      break;

    case 'card':
    default:
      $html = theme('ai_disclosure_card', ['level' => $level, 'record' => $record, 'config' => $config]);
      break;
  }

  return [
    '#type' => 'markup',
    '#markup' => '<div class="ai-disclosure-wrapper ai-disclosure-wrapper--' . check_plain($mode) . '">' . $html . '</div>',
    '#attached' => [
      'css' => [
        backdrop_get_path('module', 'ai_disclosure') . '/css/ai_disclosure.css',
      ],
    ],
  ];
}

/**
 * Implements hook_node_view().
 */
function ai_disclosure_node_view(Node $node, $view_mode, $langcode) {
  $config = config('ai_disclosure.settings');
  $enabled = ai_disclosure_enabled_bundles();

  if (!in_array($node->type, $enabled)) {
    return;
  }

  // Display only in full view or teaser if configured.
  if ($view_mode !== 'full') {
    return;
  }

  $display_pos = $config->get('display_position') ?: 'bottom';
  if ($display_pos === 'manual') {
    return;
  }

  $rendered = ai_disclosure_render_disclosure($node);
  if (empty($rendered)) {
    return;
  }

  $weight = ($display_pos === 'top') ? -100 : 100;
  $rendered['#weight'] = $weight;

  $node->content['ai_disclosure'] = $rendered;
}

/**
 * Implements hook_block_info().
 */
function ai_disclosure_block_info() {
  $blocks = [];

  $blocks['ai_disclosure_node'] = [
    'info' => t('AI Content Disclosure'),
    'description' => t('Displays AI provenance notice card or badge for the active content item.'),
  ];

  return $blocks;
}

/**
 * Implements hook_block_view().
 */
function ai_disclosure_block_view($delta = '', $settings = [], $contexts = []) {
  $block = [];

  switch ($delta) {
    case 'ai_disclosure_node':
      $node = menu_get_object('node');
      if ($node) {
        $config = config('ai_disclosure.settings');
        $enabled = ai_disclosure_enabled_bundles();
        if (in_array($node->type, $enabled)) {
          $mode = $config->get('display_mode');
          if (!$mode || $mode === 'none') {
            $mode = 'card';
          }
          $content = ai_disclosure_render_disclosure($node, $mode);
          if (!empty($content)) {
            $block['subject'] = '';
            $block['content'] = $content;
          }
        }
      }
      break;
  }

  return $block;
}

/**
 * Implements hook_preprocess_page().
 */
function ai_disclosure_preprocess_page(&$variables) {
  $node = !empty($variables['node']) ? $variables['node'] : menu_get_object('node');
  if (!$node || !is_object($node)) {
    return;
  }

  $config = config('ai_disclosure.settings');
  $enabled = ai_disclosure_enabled_bundles();
  if (!in_array($node->type, $enabled)) {
    return;
  }

  $record = isset($node->ai_disclosure) ? (array) $node->ai_disclosure : ai_disclosure_get('node', $node->nid, !empty($node->vid) ? $node->vid : NULL);
  $level = !empty($record['disclosure_level']) ? $record['disclosure_level'] : ($config->get('default_level') ?: 'human_only');
  $levels = ai_disclosure_get_levels();
  $level_info = isset($levels[$level]) ? $levels[$level] : $levels['human_only'];

  // IPTC Digital Source Type meta tag.
  if ($config->get('enable_iptc_meta') && !empty($level_info['meta_source'])) {
    $iptc_tag = [
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'digitalSourceType',
        'content' => $level_info['meta_source'],
      ],
    ];
    backdrop_add_html_head($iptc_tag, 'ai_disclosure_iptc_meta');
  }

  // Schema.org JSON-LD provenance injection.
  if ($config->get('enable_schema_org_jsonld') && ($level !== 'human_only' || $config->get('show_human_only_badge'))) {
    $resp = ai_disclosure_responsibility($record);
    $node_url = url('node/' . $node->nid, ['absolute' => TRUE]);
    $schema_data = [
      '@context' => 'https://schema.org',
      '@type' => 'CreativeWork',
      '@id' => $node_url . '#ai-disclosure',
      'isBasedOn' => $node_url,
      'name' => $level_info['label'],
    ];

    if (!empty($level_info['meta_source'])) {
      $schema_data['additionalType'] = $level_info['meta_source'];
    }

    if (!empty($resp)) {
      $schema_data['accountablePerson'] = [
        '@type' => 'Organization',
        'name' => $resp,
      ];
    }

    if (!empty($record['notes'])) {
      $schema_data['disambiguatingDescription'] = $record['notes'];
    }

    $jsonld_tag = [
      '#tag' => 'script',
      '#attributes' => [
        'type' => 'application/ld+json',
      ],
      '#value' => json_encode($schema_data, JSON_HEX_TAG | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT),
    ];
    backdrop_add_html_head($jsonld_tag, 'ai_disclosure_schema_org_jsonld');
  }
}
