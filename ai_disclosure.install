<?php

/**
 * @file
 * Install, update, and uninstall functions for AI Disclosure.
 */

/**
 * Implements hook_schema().
 */
function ai_disclosure_schema() {
  $schema = [];

  $schema['ai_disclosure'] = [
    'description' => 'Stores AI content disclosure status per entity revision.',
    'fields' => [
      'entity_type' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => 'node',
      ],
      'entity_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'revision_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'disclosure_level' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => 'human_only',
      ],
      'human_review' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'editorial_responsibility' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'notes' => [
        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
      ],
      'tool_used' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['entity_type', 'entity_id', 'revision_id'],
    'indexes' => [
      'disclosure_level' => ['disclosure_level'],
      'entity_lookup' => ['entity_type', 'entity_id'],
      'changed' => ['changed'],
    ],
  ];

  $schema['ai_disclosure_history'] = [
    'description' => 'Append-only audit trail of disclosure changes.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'entity_type' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'entity_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'revision_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'disclosure_level' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'human_review' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
      ],
      'editorial_responsibility' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'notes' => [
        'type' => 'text',
        'not null' => FALSE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'entity_history' => ['entity_type', 'entity_id'],
      'timestamp' => ['timestamp'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function ai_disclosure_uninstall() {
  config('ai_disclosure.settings')->delete();
}
